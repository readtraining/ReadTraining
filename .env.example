# Copy to .env at the repo root and fill in from your Supabase project. The API, drizzle-kit and the website all read the root .env.

# Supabase public values (safe for the browser): Project Settings > API keys
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Database (server only): Connect > Connection string
# App runtime: transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Migrations: session pooler (port 5432)
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase server access (server only, never expose to the web): Project Settings > API keys
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Web (local only; do NOT set on Vercel, where the API is served from the same domain at /api)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Emails the API sends itself (the welcome email). Same SMTP provider as Supabase's emails (Brevo in development).
# Leave SMTP_PASS empty in any file you share; set it only in your own .env.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ReadTraining <hello@example.com>"
# Development only: write emails to this folder instead of sending them (leave unset to send for real)
# EMAIL_OUTBOX_DIR=./.outbox
# The site's public address, for links in emails (http://localhost:3000 when unset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
