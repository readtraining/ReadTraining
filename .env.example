# Supabase > Project Settings > Database > Connection string
# App runtime: transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Migrations: session pooler / direct (port 5432)
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API (server only, never expose to web)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Web (local only; do NOT set on Vercel, where the API is served from the same domain at /api)
NEXT_PUBLIC_API_URL=http://localhost:4000
